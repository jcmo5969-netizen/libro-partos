# Plantilla de variables de entorno — copia a `.env` y rellena con valores reales.
# NUNCA subas el `.env` real al repositorio (está en .gitignore).

# --- Base de datos PostgreSQL (obligatorias en producción) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=libro_partos
DB_USER=cambiar_usuario
DB_PASSWORD=cambiar_password

# --- Servidor backend ---
PORT=3003
# Interfaz de escucha. Detrás de un reverse proxy usa 127.0.0.1; para LAN directa 0.0.0.0.
HOST=0.0.0.0
NODE_ENV=production

# --- Seguridad ---
# Secreto JWT (>=32 bytes). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Vigencia del token (ej. 7d, 12h).
JWT_EXPIRES_IN=7d
# Cookie de sesión solo por HTTPS. Poner 1 SOLO cuando el sitio sirva por HTTPS.
COOKIE_SECURE=0
# HSTS (requiere HTTPS). Poner 1 tras habilitar HTTPS.
ENABLE_HSTS=0
# Poner 1 si hay un reverse proxy (nginx/Caddy) delante (rate limiting por IP real).
TRUST_PROXY=0

# --- CORS ---
# Orígenes permitidos del frontend, separados por comas.
CORS_ORIGIN=http://localhost:3002

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3003/api

# --- Utilidades / scripts ---
# Solo para (re)crear el administrador con server/scripts/createAdmin.js. Borrar tras usar.
ADMIN_PASSWORD=
# ADVERTENCIA: si es 'true', el import borra la tabla antes de cargar. Mantener en false.
CLEAR_TABLE=false
