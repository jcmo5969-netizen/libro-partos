# OBSOLETO: el servidor carga las variables de entorno desde el `.env` de la RAÍZ
# del proyecto (ver server/loadEnv.js y server/db/connection.js), no desde
# server/.env. Usa el `.env.example` de la raíz del repo como plantilla autoritativa.
# Este archivo se conserva solo por compatibilidad con scripts antiguos.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=libro_partos
DB_USER=cambiar_usuario
DB_PASSWORD=cambiar_password

# Puerto del servidor backend (el valor real en producción es 3003, ver .env.example de la raíz)
PORT=5000

# Orígenes permitidos para CORS (separados por comas)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Limpiar tabla antes de importar datos (true/false)
# ADVERTENCIA: Esto borrará todos los datos existentes
CLEAR_TABLE=false
